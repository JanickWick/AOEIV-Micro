{
  "name": "freie-kompanie",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Freie Kompanie: Micro-Arena im Browser. Truppenführung in kurzen Gefechten üben: Kiten, Focus-Fire, Rückzug, Belagerung ausweichen, Kontrollgruppen.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "data:import": "node scripts/import-units.mjs",
    "data:unverified": "node scripts/list-unverified.mjs",
    "assets:gen": "NODE_USE_ENV_PROXY=1 node scripts/gen-image.mjs",
    "assets:manifest": "node scripts/assets-manifest.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
