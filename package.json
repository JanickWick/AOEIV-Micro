{
  "name": "aoe4-micro-trainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-Trainer für Age of Empires IV Micro-Mechaniken (1v1).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "data:import": "node scripts/import-units.mjs",
    "data:unverified": "node scripts/list-unverified.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
